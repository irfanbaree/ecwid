// Delete product
app.delete('/api/products/:id/', async (req, res) => {
  const { id } = req.params;
  try {
    const response = await axios.delete(
        `${ECDWID_API_URL}/${req.storeId}/products/${id}`,
        { headers: { Authorization: `Bearer ${req.apiToken}` } }
    );
    await Bundle.destroy({ where: { ecwid_id: id } });
    res.json(response.data);
  } catch (error) {
    handleApiError(error, res);
  }
});

// Create a bundle
app.post('/api/bundles', async (req, res) => {
  const { name, productIds, discount, sku, bundleImages, mainImage, costPrice } = req.body;
  const prod_ids = productIds.join(',');


  try {
    // console.log(`${ECDWID_API_URL}/${req.storeId}/products?productId=${productIds.map(id => `${id}`).join(',')}`);
    // Fetch product details from Ecwid
    const response = await axios.get(
        `${ECDWID_API_URL}/${req.storeId}/products?productId=${productIds.map(id => `${id}`).join(',')}`,
        { headers: { Authorization: `Bearer ${req.apiToken}` } }
    );

    let items = response.data.items;

    // console.log(items);

    // Calculate base price before discounts
    let basePrice = items.reduce((acc, product) => acc + product.price, 0);
    const discountValue = discount ? discount / 100 : 0;
    basePrice -= basePrice * discountValue; // Apply discount
    basePrice = 0;

    // Create product modifiers for each bundled product
    const productModifiers = items.map(product => ({
      name: `Include ${product.name}`, // Checkbox for selection
      type: "CHECKBOX",
      choices: [{
        text: `Add ${product.name}`,
        priceModifier: product.price, // Adds price when selected
        priceModifierType: "ABSOLUTE"
      }]
    }));

    // Define variations based on product combinations
    /*const variations = items.map(product => ({
      combinationNumber: product.id,
      options: [{ name: product.name, value: product.id }], // Variation name
      price: product.price, // Price per variation
      sku: `${sku}-${product.id}`, // Unique SKU per variation
      quantity: 100, // Default stock (adjust as needed)
    }));*/

    // Create quantity input fields (Text Fields for entering quantity)
    /*const quantityFields = items.map(product => ({
      name: `${product.name} Quantity`,
      type: "TEXTFIELD",
      defaultValue: "1" // Default quantity is 1
    }));*/

    // Merge checkbox options with quantity fields
    // const productOptions = [...productModifiers, ...quantityFields];
    const productOptions = [...productModifiers];

    //console.log(productOptions);

    // Save bundle in database
    const bundle = await Bundle.create({
      name,
      product_ids: JSON.stringify(productIds),
      store_id: req.storeId,
      discount,
      sku,
      price: basePrice,
      costPrice,
    });

    // Create product in Ecwid with options
    const ecwidProduct = await axios.post(
        `${ECDWID_API_URL}/${req.storeId}/products`,
        {
          name,
          price: basePrice, // Initial price before selection
          description: "-",
          enabled: true,
          sku,
          costPrice,
          unlimited: false,
          quantity: 1,
          options: productOptions // Includes checkboxes & quantity inputs
        },
        { headers: { Authorization: `Bearer ${req.apiToken}` } }
    );
    /*const ecwidProduct = await axios.post(
        `${ECDWID_API_URL}/${req.storeId}/products`,
        {
          name,
          price: basePrice,
          description: "-",
          enabled: true,
          sku,
          costPrice,
          unlimited: false,
          options: [{ name: "Product", type: "SELECT", choices: items.map(p => ({ text: p.name })) }], // Dropdown for variations
          variations, // Assign variations
        },
        { headers: { Authorization: `Bearer ${req.apiToken}` } }
);*/

    // Update bundle with Ecwid product ID
    await bundle.update({ ecwid_id: ecwidProduct.data.id });

    // Upload main image (if available)
    if (mainImage) {
      try {
        await axios.post(
            `${ECDWID_API_URL}/${req.storeId}/products/${ecwidProduct.data.id}/image/async`,
            { url: mainImage, width: 2500, height: 1500 },
            { headers: { Authorization: `Bearer ${req.apiToken}` } }
        );
      } catch (mainImageError) {
        console.warn("Main image upload failed:", mainImageError.message);
      }
    }

    // Upload gallery images (if available)
    if (bundleImages.length > 0) {
      const uploadResults = await Promise.allSettled(
          bundleImages.map(bundleImage =>
              axios.post(
                  `${ECDWID_API_URL}/${req.storeId}/products/${ecwidProduct.data.id}/gallery/async`,
                  { url: bundleImage, width: 2500, height: 1500 },
                  { headers: { Authorization: `Bearer ${req.apiToken}` } }
              )
          )
      );

      const failedUploads = uploadResults.filter(result => result.status === "rejected");
      if (failedUploads.length > 0) {
        console.warn(`Some gallery images failed to upload:`, failedUploads.length);
      }
    }

    res.json(bundle);
  } catch (error) {
    handleApiError(error, res);
  }
});

// Update a bundle
app.put('/api/bundles/:id/', async (req, res) => {
  const { id } = req.params;
  const { name, productIds, discount, sku, bundleImages, mainImage, costPrice } = req.body;

  if (!productIds || productIds.length === 0) {
    return res.status(400).json({ error: 'Product IDs cannot be empty' });
  }

  const prod_ids = productIds.join(',');

  try {
    const response = await axios.get(`${ECDWID_API_URL}/${req.storeId}/products?productId=${prod_ids}`, {
      headers: { Authorization: `Bearer ${req.apiToken}` }
    });

    if (!response.data.items || response.data.items.length !== productIds.length) {
      return res.status(400).json({ error: 'Some products could not be found' });
    }

    let price = response.data.items.reduce((acc, product) => acc + product.price, 0);
    price -= (price * (discount / 100));

    const bundle = await Bundle.findByPk(id);
    if (bundle) {
      await bundle.update({ name, product_ids: JSON.stringify(productIds), discount, sku, price, costPrice });

      const ecwidProduct = await axios.put(
          `${ECDWID_API_URL}/${req.storeId}/products/${bundle.ecwid_id}`,
          { name, price, description: "Updated bundle", enabled: true, sku, costPrice },
          { headers: { Authorization: `Bearer ${req.apiToken}` } }
      );

      try {
        if(mainImage != '') {
          await axios.post(
              `${ECDWID_API_URL}/${req.storeId}/products/${bundle.ecwid_id}/image/async`,
              {url: `${mainImage}`, width: 2500, height: 1500},
              {headers: {Authorization: `Bearer ${req.apiToken}`}}
          );
        }
        await Promise.all(
            bundleImages.map(async (bundleImage, index) => {
              await axios.post(
                  `${ECDWID_API_URL}/${req.storeId}/products/${bundle.ecwid_id}/gallery/async`,
                  { url: `${bundleImage}`, width: 2500, height: 1500 },
                  { headers: { Authorization: `Bearer ${req.apiToken}` } }
              );
            })
        );
      } catch (imageError) {
        console.error("Image download failed:", imageError);
        return res.status(500).json({ error: 'Some image downloads failed' });
      }


      res.json(bundle);
    } else {
      res.status(404).json({ error: 'Bundle not found' });
    }
  } catch (error) {
    handleApiError(error, res);
  }
});

// Delete a bundle
app.delete('/api/bundles/:id/', async (req, res) => {
  const { id } = req.params;

  try {
    const bundle = await Bundle.findByPk(id);
    if (bundle) {
      await axios.delete(`${ECDWID_API_URL}/${req.storeId}/products/${bundle.ecwid_id}`, {
        headers: { Authorization: `Bearer ${req.apiToken}` }
      });
      await bundle.destroy();
      res.json({ message: 'Bundle deleted successfully' });
    } else {
      res.status(404).json({ error: 'Bundle not found' });
    }
  } catch (error) {
    handleApiError(error, res);
  }
});


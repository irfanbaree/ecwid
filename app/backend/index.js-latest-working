function normalizeBundleProductIds(productIds) {
  if (!Array.isArray(productIds)) return [];

  return productIds
    .map((entry) => {
      if (entry && typeof entry === 'object' && entry !== null) {
        return entry.productId ?? entry.id ?? null;
      }
      return entry;
    })
    .filter((id) => id !== null && id !== undefined && id !== '')
    .map((id) => Number(id))
    .filter((id) => Number.isFinite(id) && id > 0);
}

function buildProductChoiceOptions(product) {
  const choices = [];
  const productOptions = Array.isArray(product.options) ? product.options : [];
  const productBasePrice = Number(product.price);
  const safeBasePrice = Number.isFinite(productBasePrice) && productBasePrice > 0 ? productBasePrice : 0;

  if (productOptions.length === 0) {
    choices.push({
      text: product.name,
      priceModifier: safeBasePrice,
      priceModifierType: 'ABSOLUTE',
    });
    return choices;
  }

  productOptions.forEach((option) => {
    const optionValues = Array.isArray(option.choices)
      ? option.choices
      : Array.isArray(option.values)
        ? option.values
        : [];

    if (optionValues.length === 0) {
      choices.push({
        text: `${product.name} - ${option.name}`,
        priceModifier: safeBasePrice,
        priceModifierType: 'ABSOLUTE',
      });
      return;
    }

    optionValues.forEach((choice) => {
      const label = typeof choice === 'string'
        ? choice
        : choice.text || choice.value || choice.name || choice.label || '';

      if (!label) return;

      const rawChoicePrice = typeof choice === 'object' && choice !== null
        ? (choice.priceModifier ?? product.price ?? 0)
        : (product.price ?? 0);
      const numericPrice = Number(rawChoicePrice);
      const choicePrice = Number.isFinite(numericPrice) && numericPrice >= 0 ? numericPrice : safeBasePrice;

      choices.push({
        text: `${product.name} - ${option.name}: ${label}`,
        priceModifier: choicePrice,
        priceModifierType: 'ABSOLUTE',
      });
    });
  });

  return choices;
}

function normalizeBundleOptionType(type) {
  if (type === undefined || type === null || type === '') {
    return 'single';
  }

  const normalized = String(type).trim().toLowerCase();
  const multiChoiceValues = ['multiple', 'multi', 'multiselect', 'multi-select', 'multiple-choice', 'multiplechoice', 'checkbox', 'checkboxes'];

  return multiChoiceValues.includes(normalized) || normalized === 'true' || normalized === '1'
    ? 'multiple'
    : 'single';
}

function buildBundleProductOptions(items, optionType) {
  if (!Array.isArray(items) || items.length === 0) {
    return [];
  }

  const sharedChoices = [];
  items.forEach((product) => {
    sharedChoices.push(...buildProductChoiceOptions(product));
  });

  const isMultipleChoice = normalizeBundleOptionType(optionType) === 'multiple';

  return Array.from({ length: items.length }, (_, index) => ({
    name: items.length > 1 ? `Selection ${index + 1}` : (items[0]?.name || 'Selection'),
    type: 'SELECT',
    required: true,
    ...(isMultipleChoice ? { multiple: true } : {}),
    choices: sharedChoices,
  }));
}


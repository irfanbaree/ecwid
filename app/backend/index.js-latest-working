    console.log(`Order ID: ${orderId}`);
    console.log(`Old Payment Status: ${oldPaymentStatus}`);
    console.log(`New Payment Status: ${newPaymentStatus}`);
    console.log(`Old Fulfillment Status: ${oldFulfillmentStatus}`);
    console.log(`New Fulfillment Status: ${newFulfillmentStatus}`);
    if (oldPaymentStatus == 'AWAITING_PAYMENT' && newPaymentStatus == 'PAID') {
      try {
        // Fetch the single token record
        const tokenRecord = await Token.findOne({where: {store_id: eventData.storeId}});

        if (!tokenRecord) {
          console.error(`No token found for storeId: ${eventData.storeId}`);
          return res.status(404).json({error: 'Token not found'});
        }

        // Parse JSON details column
        const tokenDetails = JSON.parse(JSON.parse(tokenRecord.details));

        const orderDetails = await axios.get(`${ECDWID_API_URL}/${eventData.storeId}/orders/${orderId}`, {

                    `${ECDWID_API_URL}/${eventData.storeId}/products/${product}`,
                    {quantity: parseInt(stock, 10)},
                    {headers: {Authorization: `Bearer ${tokenDetails.access_token}`}}
                );
              }
            });
          }else {

            let bundles = await Bundle.findAll({where: Sequelize.literal(`JSON_CONTAINS(product_ids, '${orderItem.productId}')`)});
            if (bundles) {
              let product_detail = await axios.get(
